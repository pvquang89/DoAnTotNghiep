@model IEnumerable<DoAnTotNghiep.Models.EntityModels.JobPosting>

@{
    ViewData["Title"] = @DoAnTotNghiep.Resource.Language.Danh_sách_tuyển_dụng;
}
@{
    string language = ViewContext.RouteData.Values["language"].ToString();
    Thread.CurrentThread.CurrentCulture = CultureInfo.CreateSpecificCulture(language);
    Thread.CurrentThread.CurrentUICulture = new CultureInfo(language);
}

<div class="container mt-3">
    @* <h3>@ViewData["TitleJob"] (@ViewData["JobCount"])</h3> *@
    <form asp-action="Hiring" method="get">
        <div class="form-row align-items-end">
            <div class="form-group col-md-3">
                <input type="text" class="form-control" name="title" placeholder="@DoAnTotNghiep.Resource.Language.Tìm_kiếm_việc_làm" />
            </div>
            <div class="form-group col-md-2">
                <select class="form-control" name="location">
                    <option value="">--@DoAnTotNghiep.Resource.Language.Chọn_Địa_Điểm--</option>
                    <option value="Hà Nội">@DoAnTotNghiep.Resource.Language.Hà_Nội</option>
                    <option value="Đà Nẵng">@DoAnTotNghiep.Resource.Language.Đà_Nẵng</option>
                    <option value="TP. HCM">@DoAnTotNghiep.Resource.Language.TP__HCM</option>
                </select>
            </div>
 @*            <div class="form-group col-md-2">
                <select class="form-control" name="salary">
                    <option value="">--@DoAnTotNghiep.Resource.Language.Lương_cơ_bản--</option>
                    <option value="5000000">@DoAnTotNghiep.Resource.Language._5Tr___10Tr</option>
                    <option value="10000000">@DoAnTotNghiep.Resource.Language.Trên_10Tr</option>
                </select>
            </div>
            <div class="form-group col-md-2">
                <select class="form-control" name="time">
                    <option value="">--@DoAnTotNghiep.Resource.Language.Thời_gian_làm--</option>
                    <option value="Full Time">Full Time</option>
                    <option value="Part Time">Part Time</option>
                </select>
            </div> *@

            <div class="form-group col-md-3">
                <button type="submit" class="genric-btn success medium mt-2 form-control"><i class="fas fa-search"></i></button>
            </div>
        </div>
    </form>
    @if (Model.Any())
    {
        foreach (var job in Model)
        {
            <div class="single-job-items mb-30">
                <div class="job-items">
                    <div class="company-img">
                        <a href="@Url.Action("Conpany", "Home", new { @id = @job.Employer.EmployerID })">
                            <img src="@job.Employer.UrlImage" alt="">
                        </a>
                    </div>
                    <div class="job-tittle job-tittle2">
                        <a href="@Url.Action("DetailJob", "Search", new { @id = job.JobPostingID })">
                            <h4>@job.Title</h4>
                        </a>
                        <ul>
                            <li>@DoAnTotNghiep.Resource.Language.Vị_trí_tuyển_dụng: @job.position</li>
                            <li>@DoAnTotNghiep.Resource.Language.Địa_chỉ: @job.Location</li>
                            <li>@DoAnTotNghiep.Resource.Language.Lương_cơ_bản: @job.Salary VND</li>
                        </ul>
                    </div>
                </div>
                <div class="items-link items-link2 f-right">
                    <a>@job.WorkingTime</a>
                    <span>@job.CreateAt</span>
                </div>
            </div>
        }
    }else
    {
        <partial name="_emty_search" />
    }

    </div>
